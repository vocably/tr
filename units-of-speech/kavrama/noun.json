{"transcript":"kɑvɾɑmɑ","exists":true,"definitions":["Kavramak işi veya biçimi.","Bir şeyi elle tutma, sarma veya sıkma eylemi.","Bir konuyu veya fikri anlama, idrak etme yeteneği veya eylemi."],"examples":["Elindeki nesneyi kavrama şekli.","Konuyu kavrama yeteneği oldukça iyiydi.","Makinenin kavrama gücü ayarlanabilir."],"lemma":"kavramak","lemmaPos":"verb","synonyms":["anlama","idrak","tutma","yakalama"],"number":"singular","pluralForm":"kavramalar","source":"kavrama"}